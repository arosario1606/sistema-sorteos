# PostgreSQL de la intranet; el módulo usa SU PROPIO esquema (se crea con `npm run migrate:deploy`).
DATABASE_URL="postgresql://usuario:clave@localhost:5432/intranet?schema=sorteos"
PORT=3000

# Mismo valor que usa el gateway de la intranet para firmar x-auth-token. En desarrollo use uno de PRUEBA;
# el real lo entrega el equipo de la intranet y NO se sube al repositorio.
SERVICES_SECRET_KEY=cambiar-por-un-secreto-de-prueba

# Esquemas de la intranet de donde se copian sedes y empleados (valores por defecto)
INTRANET_AUTH_SCHEMA=intranet_api_auth_manager
INTRANET_EMPLOYEES_SCHEMA=intranet_employees_db

# Solo desarrollo local: usuario simulado para `npm run seed:dev` y `npm run dev:token`
DEV_USER_ID=1
DEV_USER_EMAIL=usuario.prueba@example.com
