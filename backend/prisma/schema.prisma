generator client {
  provider = "prisma-client-js"
}

// PostgreSQL de la intranet. Todas las tablas del módulo viven en su propio esquema
// (el que indique DATABASE_URL con ?schema=sorteos); no se tocan los esquemas de otros sistemas.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. Employee: copia propia de los empleados (se actualiza con `npm run sync:employees`
//    y se completa con las cédulas nuevas que lleguen en los CSV de participantes).
model Employee {
  employeeId Int       @id @default(autoincrement()) @map("employee_id")
  cedula     String    @unique @db.VarChar(50)
  names      String    @db.VarChar(100)
  lastName   String    @map("last_name") @db.VarChar(100)
  bornDate   DateTime? @map("bornDate") @db.Date
  email      String?   @db.VarChar(150)
  isActive   Boolean   @default(true) @map("isActive")
  createdAt  DateTime  @default(now()) @map("createdAt")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updatedAt")

  @@map("Employee")
}

// 2. Sede: configuración propia de las sedes. Ya NO es una copia de Locations: el nombre y si la sede está
//    activa en la intranet se leen en vivo de la vista v_sede (ver docs/integracion/vistas-sorteos.sql).
//    Aquí solo queda la decisión de este módulo: `active = false` oculta una sede al crear sorteos nuevos
//    (y al asignarla a usuarios) sin perder el historial. Una sede sin fila cuenta como activa.
//    Sin claves foráneas: la fila puede no existir y la sede puede desaparecer de Locations.
model Sede {
  idSede    Int      @id @map("id_sede")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("Sede")
}

// 3. User_branch_permission: sedes sobre las que un usuario puede crear sorteos.
//    userId = Users.id de la intranet (viene en el token); el nombre y el correo se leen de la vista v_users.
//    Se administra desde la pantalla «Permisos por Sedes» (createdBy = correo de quien lo asignó).
model UserBranchPermission {
  userId    Int      @map("user_id")
  idSede    Int      @map("id_sede")
  createdBy String   @map("created_by") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, idSede])
  @@map("User_branch_permission")
}

// 4. Branch_group
model BranchGroup {
  groupId   Int      @id @default(autoincrement()) @map("group_id")
  name      String   @db.VarChar(150)
  createdBy String   @map("created_by") @db.VarChar(100)
  updatedBy String?  @map("updated_by") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  details BranchGroupDetail[]
  quotas  DepartmentQuota[]
  sorteos Sorteos[]

  @@map("Branch_group")
}

// 5. Branch_group_detail
model BranchGroupDetail {
  groupId   Int      @map("group_id")
  idSede    Int      @map("id_sede")
  createdAt DateTime @default(now()) @map("created_at")

  branchGroup BranchGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)

  @@id([groupId, idSede])
  @@map("Branch_group_detail")
}

// 6. Department
model Department {
  idDepartment Int      @id @default(autoincrement()) @map("id_department")
  name         String   @db.VarChar(100)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  quotas       DepartmentQuota[]
  participants Participant[]

  @@map("Department")
}

// 7. Department_quota
model DepartmentQuota {
  groupId         Int      @map("group_id")
  idDepartment    Int      @map("id_department")
  allowedQuantity Int      @map("allowed_quantity")
  createdBy       String   @map("created_by") @db.VarChar(100)
  updatedBy       String?  @map("updated_by") @db.VarChar(100)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  branchGroup BranchGroup @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
  department  Department  @relation(fields: [idDepartment], references: [idDepartment], onDelete: Cascade)

  @@id([groupId, idDepartment])
  @@map("Department_quota")
}

// 8. Sorteos
model Sorteos {
  idSorteos  Int      @id @default(autoincrement()) @map("id_sorteos")
  name       String   @db.VarChar(150)
  sorteoDate DateTime @map("sorteo_date") @db.Date
  groupId    Int      @map("group_id")
  createdBy  String   @map("created_by") @db.VarChar(100)
  updatedBy  String?  @map("updated_by") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  branchGroup  BranchGroup   @relation(fields: [groupId], references: [groupId])
  participants Participant[]

  @@map("Sorteos")
}

// 9. Participant
model Participant {
  idParticipant Int      @id @default(autoincrement()) @map("id_participant")
  idSorteos     Int      @map("id_sorteos")
  cedula        String   @db.VarChar(50)
  idDepartment  Int      @map("id_department")
  jobTitle      String   @map("job_title") @db.VarChar(100)
  participate   Boolean  @default(true)
  attended      Boolean  @default(false)
  createdBy     String   @map("created_by") @db.VarChar(100)
  updatedBy     String?  @map("updated_by") @db.VarChar(100)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  sorteos    Sorteos    @relation(fields: [idSorteos], references: [idSorteos], onDelete: Cascade)
  department Department @relation(fields: [idDepartment], references: [idDepartment])
  winner     Winner?

  @@unique([idSorteos, cedula])
  @@map("Participant")
}

// 10. Winner
model Winner {
  idParticipant Int      @id @map("id_participant")
  winningOrder  Int      @map("winning_order")
  createdAt     DateTime @default(now()) @map("created_at")

  participant Participant @relation(fields: [idParticipant], references: [idParticipant], onDelete: Cascade)

  @@map("Winner")
}

// 11. Winner_history: registro PERMANENTE de los ganadores. Se llena al finalizar un sorteo, dentro de la misma
//     transacción que borra todo lo demás, y no se borra nunca. Es una foto sin claves foráneas: no depende de
//     Sorteos, Winner ni Employee (el sorteo se borra y el empleado puede cambiar de nombre o desaparecer).
//     `sorteoName` + `sorteoDate` identifican el sorteo; son los únicos datos del sorteo que quedan guardados.
model WinnerHistory {
  id           Int      @id @default(autoincrement())
  sorteoName   String   @map("sorteo_name") @db.VarChar(150)
  sorteoDate   DateTime @map("sorteo_date") @db.Date
  cedula       String   @db.VarChar(50)
  fullName     String   @map("full_name") @db.VarChar(250)
  department   String   @db.VarChar(100)
  winningOrder Int      @map("winning_order")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([cedula])
  @@index([sorteoDate])
  @@map("Winner_history")
}
